shader_type canvas_item;

uniform vec4 outline_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform float outline_width : hint_range(0.0, 8.0) = 2.0;

void fragment() {
	vec4 col = texture(TEXTURE, UV);

	if (col.a < 0.5) {
		vec2 texel = outline_width / vec2(textureSize(TEXTURE, 0));
		float alpha = 0.0;

		alpha += texture(TEXTURE, UV + vec2(texel.x, 0.0)).a;
		alpha += texture(TEXTURE, UV + vec2(-texel.x, 0.0)).a;
		alpha += texture(TEXTURE, UV + vec2(0.0, texel.y)).a;
		alpha += texture(TEXTURE, UV + vec2(0.0, -texel.y)).a;
		alpha += texture(TEXTURE, UV + vec2(texel.x, texel.y)).a;
		alpha += texture(TEXTURE, UV + vec2(-texel.x, -texel.y)).a;
		alpha += texture(TEXTURE, UV + vec2(texel.x, -texel.y)).a;
		alpha += texture(TEXTURE, UV + vec2(-texel.x, texel.y)).a;

		if (alpha > 0.0) {
			col = vec4(outline_color.rgb, min(alpha, 1.0) * outline_color.a);
		}
	}

	COLOR = col;
}
